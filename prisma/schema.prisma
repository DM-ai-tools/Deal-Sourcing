// BizBuySell deal-sourcing system — persistence.
//
// Postgres, not SQLite: Railway's filesystem is ephemeral, and the one thing
// this system must never lose is the record of who has already been contacted.
// A wiped database means brokers get messaged twice.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A saved set of filters. Re-runnable: the same search executed weekly is the
/// normal mode of operation, which is why filters are a stored entity rather
/// than arguments to a script.
model Search {
  id   String @id @default(cuid())
  name String

  /// Empty means every location.
  states     Json @default("[]") // string[] of two-letter codes
  industries Json @default("[]") // string[] of BizBuySell industry slugs

  cashFlowMin     Int?
  cashFlowMax     Int?
  revenueMin      Int?
  revenueMax      Int?
  askingPriceMin  Int?
  askingPriceMax  Int?

  /// Auctions are excluded by default — they are not a broker conversation.
  excludeAuctions Boolean @default(true)

  active    Boolean  @default(true)
  runs      Run[]
  listings  Listing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One execution of a search.
model Run {
  id       String @id @default(cuid())
  searchId String
  search   Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  /// queued | discovering | contacting | done | stopped | failed
  status String @default("queued")

  /// A run that only reads and prepares. The default, always — arming is a
  /// deliberate act because sending cannot be undone.
  dryRun Boolean @default(true)

  /// Which transport actually reached the site, recorded per run so a failure
  /// six weeks later can be attributed.
  transport String @default("firecrawl")

  pagesRead      Int @default(0)
  listingsFound  Int @default(0)
  listingsNew    Int @default(0)
  messagesSent   Int @default(0)
  messagesFailed Int @default(0)

  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  events   RunEvent[]
  outreach Outreach[]

  @@index([status])
  @@index([startedAt])
}

/// Progress, kept in the database rather than in memory so the dashboard shows
/// the same story after a restart as before it.
model RunEvent {
  id    String @id @default(cuid())
  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  level   String @default("info") // info | warn | error
  message String
  detail  Json?

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

/// A business for sale. The listing ID in BizBuySell's own URL is the natural
/// key — slugs and titles change, that number does not.
model Listing {
  id        String  @id @default(cuid())
  listingId String  @unique
  searchId  String?
  search    Search? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  title    String
  url      String
  location String?

  askingPrice  Int?
  grossRevenue Int?
  cashFlow     Int?
  ebitda       Int?
  established  String?

  brokerName  String?
  brokerPhone String?

  /// When BizBuySell says the listing was posted. Kept as the site's own text
  /// ("2 days ago", "Listed 12 Jul") plus a parsed date where one is derivable —
  /// a relative phrase is still useful to a human even when it will not sort.
  datePosted     String?
  datePostedAt   DateTime?

  isAuction Boolean @default(false)

  /// Pipeline state. Set to 'email_sent' once by the system and never touched
  /// by it again — every later value is the team's.
  status String @default("new")
  // new | email_sent | nda_signed | cim_sent | in_progress | loi_sent | deal_flow | rejected

  notes String?

  /// Raw extraction, kept so a parsing bug can be re-run without re-fetching.
  raw Json?

  firstSeenAt DateTime  @default(now())
  contactedAt DateTime?
  /// Set when a broker replies. Drives the green indicator and the sheet.
  respondedAt DateTime?
  /// What they actually said, so the sheet can carry it without a mailbox.
  responseNote String?
  updatedAt   DateTime  @updatedAt

  outreach Outreach[]
  replies  Reply[]

  @@index([status])
  @@index([searchId])
}

/// An email that arrived in the buyer's inbox.
///
/// Every message the monitor reads is stored, matched or not. An unmatched
/// reply is the interesting failure: it means a broker answered and the system
/// could not work out which listing they meant — which must surface as a row
/// someone can act on, not vanish because a title did not match.
model Reply {
  id        String   @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  /// The mailbox's own Message-ID. Unique, so re-reading a message — after a
  /// restart, a UID reset, or a bug — updates rather than duplicates.
  messageId String   @unique
  uid       Int?

  fromEmail String
  fromName  String?
  subject   String?
  snippet   String?
  body      String?

  /// How the match was made: listing-id | url | title | broker | none.
  /// Recorded because a wrong match is worse than none, and this is the only
  /// way to tell afterwards which rule was responsible.
  matchedBy String @default("none")

  /// Out-of-office and delivery failures are not a broker's answer. Kept, so
  /// a bounce is visible, but they never flip a listing to Responded.
  isAutoReply Boolean @default(false)
  isBounce    Boolean @default(false)

  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@index([listingId])
  @@index([receivedAt])
}

/// One attempt to contact one listing.
///
/// The unique constraint on listingId is the real guarantee that a broker is
/// never messaged twice. It is enforced here rather than in application code
/// because a race between two runs would otherwise slip through.
model Outreach {
  id        String  @id @default(cuid())
  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  runId     String?
  run       Run?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// prepared | sent | failed | skipped
  status String @default("prepared")

  messageBody String
  fullName    String
  email       String
  phone       String?

  attempts     Int     @default(0)
  error        String?
  screenshot   String? // base64 PNG of the failure, for auditing
  confirmation String? // whatever the page said back

  preparedAt DateTime  @default(now())
  sentAt     DateTime?

  @@index([status])
}

/// Single-row configuration.
model Settings {
  id Int @id @default(1)

  fullName String @default("")
  email    String @default("")
  phone    String @default("")

  messageTemplate String @default("")

  /// The master arming switch. False means every run is a dry run whatever the
  /// run itself requests.
  sendingEnabled Boolean @default(false)

  dailyCap        Int @default(40)
  minDelaySeconds Int @default(45)
  maxDelaySeconds Int @default(120)

  /// firecrawl | local | proxy | camoufox | auto
  /// Defaults to auto: try the working transport first and fall through the
  /// alternatives rather than failing on whichever one happened to be selected.
  transport String @default("auto")

  bizbuysellEmail    String?
  bizbuysellPassword String?

  proxyServer   String?
  proxyUsername String?
  proxyPassword String?

  /// Google Sheet mirror. The sheet is a VIEW of the database, never the source
  /// of truth — it is rewritten on every sync, so editing it does not feed back.
  /// That direction is deliberate: two writable copies of the same pipeline is
  /// how a status gets silently reverted.
  sheetsEnabled       Boolean @default(false)
  sheetId             String?
  /// Service-account JSON, as downloaded from Google Cloud.
  googleCredentials   String?
  sheetsLastSyncedAt  DateTime?
  sheetsLastError     String?

  /// One scan per day, unattended.
  ///
  /// Without this the system only runs when somebody clicks something, so
  /// "check BizBuySell daily" quietly becomes "check it when anyone remembers"
  /// — and a business in this band is under offer within days. 14:00 UTC is
  /// mid-morning across the US business day, so an enquiry arrives while the
  /// broker is at their desk rather than at three in the morning.
  dailyScanEnabled Boolean   @default(true)
  scanHourUtc      Int       @default(14)
  lastScheduledAt  DateTime?

  /// Inbox monitoring — how a broker's reply reaches the tracker on its own.
  ///
  /// Read-only against the mailbox, always. This connects to someone's real
  /// business inbox, so it opens folders in read-only mode, never deletes,
  /// never marks anything seen, and tracks its position by UID. If it has a
  /// bug, the worst it can do is read a message twice.
  inboxEnabled    Boolean   @default(false)
  /// imap | graph.
  ///
  /// Defaults to graph because the mailbox this was built for is on Exchange
  /// Online, where IMAP with a password cannot work at all — Microsoft turned
  /// basic authentication off service-wide, and the probe gets
  /// "AUTHENTICATE failed" for an entirely correct password. IMAP stays for
  /// mailboxes that do allow it.
  inboxProvider   String    @default("graph")
  inboxHost       String?
  inboxPort       Int       @default(993)
  inboxUser       String?
  inboxPassword   String?

  /// Entra app registration, for the Graph route. Needs the APPLICATION
  /// permission Mail.Read with admin consent — the delegated one will not work
  /// for a daemon, because no user is present to approve anything.
  graphTenantId     String?
  graphClientId     String?
  graphClientSecret String?

  /// The newest message already processed. Graph has no UID, so the watermark
  /// is a timestamp; it advances per message so a poll that dies halfway
  /// resumes rather than skipping to the newest.
  inboxWatermark  DateTime?
  /// Highest UID already ingested, so a restart resumes instead of re-reading
  /// the whole mailbox — and so a reply is never processed twice.
  inboxLastUid    Int       @default(0)
  inboxLastCheckedAt DateTime?
  inboxLastError  String?

  /// Which saved search the scheduler and the arming switch actually run.
  ///
  /// This was inferred from timestamps and both guesses were wrong in turn.
  /// "Oldest" ran a search the operator had replaced; "most recently updated"
  /// ran a fifty-state duplicate created minutes earlier, which turned twelve
  /// URLs into six hundred and failed for three hours without contacting
  /// anyone. Which buy-box is live is a decision, not something to derive.
  activeSearchId String?

  updatedAt DateTime @updatedAt @default(now())
}
